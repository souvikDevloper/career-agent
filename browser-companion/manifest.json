{
  "manifest_version": 3,
  "name": "Career Agent Browser Companion",
  "version": "1.1.0",
  "description": "Fills and submits an explicitly approved Career Agent application in your signed-in browser session.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
